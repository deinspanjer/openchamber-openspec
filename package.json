{
  "name": "openchamber-openspec",
  "version": "1.2.3-dre.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preversion": "npm run check",
    "version": "npm run build && git add panel/main.js panel/status.js service/main.js",
    "build": "npm run build:panel && npm run build:status && npm run build:service",
    "build:panel": "node scripts/build-extension.mjs panel",
    "build:service": "node scripts/build-extension.mjs service",
    "build:model:test": "esbuild src/model.ts --bundle --format=esm --platform=node --target=node22 --outfile=build/model.mjs",
    "build:resources:test": "esbuild src/panel/resources.ts --bundle --format=esm --platform=node --target=node22 --outfile=build/resources.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "lint": "eslint src eslint.config.mjs",
    "lint:fix": "eslint src eslint.config.mjs --fix",
    "format:check": "prettier --check src test scripts/*.mjs panel/*.html service/package.json package.json tsconfig.json eslint.config.mjs README.md .prettierrc .vscode/tasks.json",
    "format": "prettier --write src test scripts/*.mjs panel/*.html service/package.json package.json tsconfig.json eslint.config.mjs README.md .prettierrc .vscode/tasks.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run build:model:test && npm run build:resources:test && node --test test/*.test.mjs",
    "clean": "node -e \"for (const file of ['panel/main.js', 'panel/status.js', 'service/main.js']) require('node:fs').rmSync(file, { force: true })\"",
    "build:status": "node scripts/build-extension.mjs status",
    "dev:deploy": "node scripts/build-extension.mjs dev",
    "check:version": "node scripts/check-extension-version.mjs"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.1"
    },
    "contributes": {
      "panel": {
        "id": "openspec-board",
        "name": "OpenSpec",
        "icon": "assets/openspec-logo.svg",
        "entry": "panel/index.html",
        "mobile": true
      },
      "page": true,
      "capabilities": [
        "prompt",
        "sessions"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "openspec",
            "git"
          ]
        }
      },
      "statusSection": {
        "entry": "panel/status.html",
        "title": "OpenSpec",
        "height": 160,
        "requiresProject": true
      }
    }
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.3",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "playwright": "^1.58.2",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
